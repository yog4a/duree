{
  "name": "duree",
  "displayName": "Durée",
  "description": "Local coding-time tracker. No network. The journal keeps counters and paths, not text.",
  "version": "0.4.0",
  "publisher": "yogaa",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "install-cursor": "npm run build && node scripts/install.mjs",
    "test": "node --test dist/heartbeat/heartbeat.test.js dist/dependencies/dependencies.test.js dist/ai/ai.test.js dist/store/store.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.89.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "duree.showToday",
        "title": "Durée: Today"
      },
      {
        "command": "duree.showHistory",
        "title": "Durée: History"
      }
    ]
  }
}
